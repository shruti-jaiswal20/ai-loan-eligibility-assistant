# Copy this file to .env and fill in real values before deploying.

# --- LLM Provider ---
# If left blank, the app runs in MOCK_LLM mode automatically (deterministic
# rule-based responses) so the whole pipeline is demoable with zero API keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- AWS (used by utils/s3_storage.py and deployment) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=
# On EC2 with an IAM instance role (no access keys), set this to 1 so S3 is treated as configured.
S3_USE_INSTANCE_ROLE=
# Leave blank for real AWS. Set to http://localstack:4566 when running via
# docker-compose.yml to exercise the S3 integration against LocalStack.
AWS_ENDPOINT_URL=

# --- App ---
APP_ENV=local
